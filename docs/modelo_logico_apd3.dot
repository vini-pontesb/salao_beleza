digraph modelo {
  graph [rankdir=LR, fontname="Helvetica", nodesep=0.5, ranksep=1.1, label="Base de dados do salão de beleza · modelo lógico (APD1 + tabelas da APD3)", labelloc=t, fontsize=18];
  node [shape=plain, fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=8, color="#555555", arrowhead=crow, arrowtail=tee, dir=both];
  "public.cliente" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td colspan="3" bgcolor="#1E487C"><font color="white"><b>public.cliente</b></font></td></tr><tr><td align="left">PK</td><td align="left"><b>id_cliente</b></td><td align="left"><font color="#555555">integer</font></td></tr><tr><td align="left"></td><td align="left">nome</td><td align="left"><font color="#555555">text</font></td></tr><tr><td align="left"></td><td align="left">telefone</td><td align="left"><font color="#555555">text (nulo)</font></td></tr><tr><td align="left"></td><td align="left">email</td><td align="left"><font color="#555555">text (nulo)</font></td></tr><tr><td align="left"></td><td align="left">data_nascimento</td><td align="left"><font color="#555555">date (nulo)</font></td></tr><tr><td align="left"></td><td align="left">data_cadastro</td><td align="left"><font color="#555555">date</font></td></tr></table>>];
  "public.profissional" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td colspan="3" bgcolor="#1E487C"><font color="white"><b>public.profissional</b></font></td></tr><tr><td align="left">PK</td><td align="left"><b>id_profissional</b></td><td align="left"><font color="#555555">integer</font></td></tr><tr><td align="left"></td><td align="left">nome</td><td align="left"><font color="#555555">text</font></td></tr><tr><td align="left"></td><td align="left">especialidade</td><td align="left"><font color="#555555">text (nulo)</font></td></tr><tr><td align="left"></td><td align="left">telefone</td><td align="left"><font color="#555555">text (nulo)</font></td></tr><tr><td align="left"></td><td align="left">comissao_percentual</td><td align="left"><font color="#555555">numeric(5,2)</font></td></tr><tr><td align="left"></td><td align="left">data_admissao</td><td align="left"><font color="#555555">date (nulo)</font></td></tr></table>>];
  "public.servico" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td colspan="3" bgcolor="#1E487C"><font color="white"><b>public.servico</b></font></td></tr><tr><td align="left">PK</td><td align="left"><b>id_servico</b></td><td align="left"><font color="#555555">integer</font></td></tr><tr><td align="left"></td><td align="left">nome</td><td align="left"><font color="#555555">text</font></td></tr><tr><td align="left"></td><td align="left">descricao</td><td align="left"><font color="#555555">text (nulo)</font></td></tr><tr><td align="left"></td><td align="left">categoria</td><td align="left"><font color="#555555">character varying(30)</font></td></tr><tr><td align="left"></td><td align="left">preco</td><td align="left"><font color="#555555">numeric(10,2)</font></td></tr><tr><td align="left"></td><td align="left">duracao_minutos</td><td align="left"><font color="#555555">integer (nulo)</font></td></tr><tr><td align="left"></td><td align="left">ativo</td><td align="left"><font color="#555555">smallint</font></td></tr></table>>];
  "public.agendamento" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td colspan="3" bgcolor="#1E487C"><font color="white"><b>public.agendamento</b></font></td></tr><tr><td align="left">PK</td><td align="left"><b>id_agendamento</b></td><td align="left"><font color="#555555">integer</font></td></tr><tr><td align="left">FK</td><td align="left">id_cliente</td><td align="left"><font color="#555555">integer</font></td></tr><tr><td align="left">FK</td><td align="left">id_profissional</td><td align="left"><font color="#555555">integer</font></td></tr><tr><td align="left">FK</td><td align="left">id_servico</td><td align="left"><font color="#555555">integer</font></td></tr><tr><td align="left"></td><td align="left">data_agendamento</td><td align="left"><font color="#555555">date</font></td></tr><tr><td align="left"></td><td align="left">hora</td><td align="left"><font color="#555555">text (nulo)</font></td></tr><tr><td align="left"></td><td align="left">valor</td><td align="left"><font color="#555555">numeric(10,2) (nulo)</font></td></tr><tr><td align="left"></td><td align="left">status</td><td align="left"><font color="#555555">text</font></td></tr></table>>];
  "public.pagamento" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td colspan="3" bgcolor="#1E487C"><font color="white"><b>public.pagamento</b></font></td></tr><tr><td align="left">PK</td><td align="left"><b>id_pagamento</b></td><td align="left"><font color="#555555">integer</font></td></tr><tr><td align="left">FK</td><td align="left">id_agendamento</td><td align="left"><font color="#555555">integer</font></td></tr><tr><td align="left"></td><td align="left">forma_pagamento</td><td align="left"><font color="#555555">character varying(20)</font></td></tr><tr><td align="left"></td><td align="left">valor_pago</td><td align="left"><font color="#555555">numeric(10,2)</font></td></tr><tr><td align="left"></td><td align="left">desconto</td><td align="left"><font color="#555555">numeric(10,2)</font></td></tr><tr><td align="left"></td><td align="left">parcelas</td><td align="left"><font color="#555555">smallint</font></td></tr><tr><td align="left"></td><td align="left">data_hora_pagamento</td><td align="left"><font color="#555555">timestamp without time zone</font></td></tr></table>>];
  "public.produto" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td colspan="3" bgcolor="#1E487C"><font color="white"><b>public.produto</b></font></td></tr><tr><td align="left">PK</td><td align="left"><b>id_produto</b></td><td align="left"><font color="#555555">integer</font></td></tr><tr><td align="left"></td><td align="left">nome</td><td align="left"><font color="#555555">character varying(100)</font></td></tr><tr><td align="left"></td><td align="left">marca</td><td align="left"><font color="#555555">character varying(60)</font></td></tr><tr><td align="left"></td><td align="left">categoria</td><td align="left"><font color="#555555">character varying(30)</font></td></tr><tr><td align="left"></td><td align="left">preco_venda</td><td align="left"><font color="#555555">numeric(10,2)</font></td></tr><tr><td align="left"></td><td align="left">qtd_estoque</td><td align="left"><font color="#555555">integer</font></td></tr><tr><td align="left"></td><td align="left">estoque_minimo</td><td align="left"><font color="#555555">integer</font></td></tr><tr><td align="left"></td><td align="left">codigo_barras</td><td align="left"><font color="#555555">character(13) (nulo)</font></td></tr><tr><td align="left"></td><td align="left">ativo</td><td align="left"><font color="#555555">boolean</font></td></tr></table>>];
  "public.venda_produto" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td colspan="3" bgcolor="#1E487C"><font color="white"><b>public.venda_produto</b></font></td></tr><tr><td align="left">PK</td><td align="left"><b>id_venda</b></td><td align="left"><font color="#555555">integer</font></td></tr><tr><td align="left">FK</td><td align="left">id_cliente</td><td align="left"><font color="#555555">integer</font></td></tr><tr><td align="left">FK</td><td align="left">id_produto</td><td align="left"><font color="#555555">integer</font></td></tr><tr><td align="left">FK</td><td align="left">id_profissional</td><td align="left"><font color="#555555">integer (nulo)</font></td></tr><tr><td align="left"></td><td align="left">quantidade</td><td align="left"><font color="#555555">smallint</font></td></tr><tr><td align="left"></td><td align="left">valor_unitario</td><td align="left"><font color="#555555">numeric(10,2)</font></td></tr><tr><td align="left"></td><td align="left">forma_pagamento</td><td align="left"><font color="#555555">character varying(20)</font></td></tr><tr><td align="left"></td><td align="left">data_venda</td><td align="left"><font color="#555555">timestamp without time zone</font></td></tr></table>>];
  "seguranca.usuario_profissional" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td colspan="3" bgcolor="#7A4E9E"><font color="white"><b>seguranca.usuario_profissional  (APD3)</b></font></td></tr><tr><td align="left">PK</td><td align="left"><b>usuario</b></td><td align="left"><font color="#555555">name</font></td></tr><tr><td align="left">FK</td><td align="left">id_profissional</td><td align="left"><font color="#555555">integer</font></td></tr><tr><td align="left"></td><td align="left">criado_em</td><td align="left"><font color="#555555">timestamp with time zone</font></td></tr></table>>];
  "auditoria.registro_alteracao" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td colspan="3" bgcolor="#7A4E9E"><font color="white"><b>auditoria.registro_alteracao  (APD3)</b></font></td></tr><tr><td align="left">PK</td><td align="left"><b>id</b></td><td align="left"><font color="#555555">bigint</font></td></tr><tr><td align="left"></td><td align="left">momento</td><td align="left"><font color="#555555">timestamp with time zone</font></td></tr><tr><td align="left"></td><td align="left">usuario_sessao</td><td align="left"><font color="#555555">text</font></td></tr><tr><td align="left"></td><td align="left">papel_efetivo</td><td align="left"><font color="#555555">text</font></td></tr><tr><td align="left"></td><td align="left">aplicacao</td><td align="left"><font color="#555555">text (nulo)</font></td></tr><tr><td align="left"></td><td align="left">endereco_cliente</td><td align="left"><font color="#555555">inet (nulo)</font></td></tr><tr><td align="left"></td><td align="left">tabela</td><td align="left"><font color="#555555">text</font></td></tr><tr><td align="left"></td><td align="left">operacao</td><td align="left"><font color="#555555">text</font></td></tr><tr><td align="left"></td><td align="left">registro_id</td><td align="left"><font color="#555555">bigint (nulo)</font></td></tr><tr><td align="left"></td><td align="left">colunas_alteradas</td><td align="left"><font color="#555555">text[] (nulo)</font></td></tr><tr><td align="left"></td><td align="left">transacao</td><td align="left"><font color="#555555">bigint</font></td></tr></table>>];
  "public.cliente" -> "public.agendamento" [label="id_cliente"];
  "public.profissional" -> "public.agendamento" [label="id_profissional"];
  "public.servico" -> "public.agendamento" [label="id_servico"];
  "public.agendamento" -> "public.pagamento" [label="id_agendamento"];
  "public.profissional" -> "seguranca.usuario_profissional" [label="id_profissional"];
  "public.cliente" -> "public.venda_produto" [label="id_cliente"];
  "public.produto" -> "public.venda_produto" [label="id_produto"];
  "public.profissional" -> "public.venda_produto" [label="id_profissional"];
}
