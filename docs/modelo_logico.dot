digraph modelo_logico {
  graph [rankdir=LR, splines=true, nodesep=0.5, ranksep=1.6, bgcolor="white", pad=0.3, dpi=170,
         label="Modelo lógico - Sistema de Gestão de Salão de Beleza (PostgreSQL)", labelloc=t, fontsize=20, fontname="Helvetica-Bold"];
  node [shape=plaintext, fontname="Helvetica"];
  edge [fontname="Helvetica", fontsize=9, color="#555555", dir=both, arrowtail=none];
  cliente [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="5"><tr><td colspan="3" bgcolor="#1F4E79"><font color="white"><b>cliente</b></font></td></tr><tr><td align="left" bgcolor="#FFF2CC" port="id_cliente_w">PK</td><td align="left" bgcolor="#FFF2CC"><b>id_cliente</b></td><td align="left" bgcolor="#FFF2CC" port="id_cliente_e"><font color="#555555">serial</font></td></tr><tr><td align="left" bgcolor="white" port="nome_w"></td><td align="left" bgcolor="white">nome</td><td align="left" bgcolor="white" port="nome_e"><font color="#555555">text NN</font></td></tr><tr><td align="left" bgcolor="white" port="telefone_w"></td><td align="left" bgcolor="white">telefone</td><td align="left" bgcolor="white" port="telefone_e"><font color="#555555">text</font></td></tr><tr><td align="left" bgcolor="white" port="email_w"></td><td align="left" bgcolor="white">email</td><td align="left" bgcolor="white" port="email_e"><font color="#555555">text U</font></td></tr><tr><td align="left" bgcolor="white" port="data_nascimento_w"></td><td align="left" bgcolor="white">data_nascimento</td><td align="left" bgcolor="white" port="data_nascimento_e"><font color="#555555">date</font></td></tr><tr><td align="left" bgcolor="white" port="data_cadastro_w"></td><td align="left" bgcolor="white">data_cadastro</td><td align="left" bgcolor="white" port="data_cadastro_e"><font color="#555555">date NN</font></td></tr></table>>];
  profissional [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="5"><tr><td colspan="3" bgcolor="#1F4E79"><font color="white"><b>profissional</b></font></td></tr><tr><td align="left" bgcolor="#FFF2CC" port="id_profissional_w">PK</td><td align="left" bgcolor="#FFF2CC"><b>id_profissional</b></td><td align="left" bgcolor="#FFF2CC" port="id_profissional_e"><font color="#555555">serial</font></td></tr><tr><td align="left" bgcolor="white" port="nome_w"></td><td align="left" bgcolor="white">nome</td><td align="left" bgcolor="white" port="nome_e"><font color="#555555">text NN</font></td></tr><tr><td align="left" bgcolor="white" port="especialidade_w"></td><td align="left" bgcolor="white">especialidade</td><td align="left" bgcolor="white" port="especialidade_e"><font color="#555555">text</font></td></tr><tr><td align="left" bgcolor="white" port="telefone_w"></td><td align="left" bgcolor="white">telefone</td><td align="left" bgcolor="white" port="telefone_e"><font color="#555555">text</font></td></tr><tr><td align="left" bgcolor="white" port="comissao_percentual_w"></td><td align="left" bgcolor="white">comissao_percentual</td><td align="left" bgcolor="white" port="comissao_percentual_e"><font color="#555555">numeric(5,2) NN</font></td></tr><tr><td align="left" bgcolor="white" port="data_admissao_w"></td><td align="left" bgcolor="white">data_admissao</td><td align="left" bgcolor="white" port="data_admissao_e"><font color="#555555">date</font></td></tr></table>>];
  servico [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="5"><tr><td colspan="3" bgcolor="#1F4E79"><font color="white"><b>servico</b></font></td></tr><tr><td align="left" bgcolor="#FFF2CC" port="id_servico_w">PK</td><td align="left" bgcolor="#FFF2CC"><b>id_servico</b></td><td align="left" bgcolor="#FFF2CC" port="id_servico_e"><font color="#555555">serial</font></td></tr><tr><td align="left" bgcolor="white" port="nome_w"></td><td align="left" bgcolor="white">nome</td><td align="left" bgcolor="white" port="nome_e"><font color="#555555">text NN,U</font></td></tr><tr><td align="left" bgcolor="white" port="descricao_w"></td><td align="left" bgcolor="white">descricao</td><td align="left" bgcolor="white" port="descricao_e"><font color="#555555">text</font></td></tr><tr><td align="left" bgcolor="white" port="categoria_w"></td><td align="left" bgcolor="white">categoria</td><td align="left" bgcolor="white" port="categoria_e"><font color="#555555">varchar(30) NN</font></td></tr><tr><td align="left" bgcolor="white" port="preco_w"></td><td align="left" bgcolor="white">preco</td><td align="left" bgcolor="white" port="preco_e"><font color="#555555">numeric(10,2) NN</font></td></tr><tr><td align="left" bgcolor="white" port="duracao_minutos_w"></td><td align="left" bgcolor="white">duracao_minutos</td><td align="left" bgcolor="white" port="duracao_minutos_e"><font color="#555555">integer</font></td></tr><tr><td align="left" bgcolor="white" port="ativo_w"></td><td align="left" bgcolor="white">ativo</td><td align="left" bgcolor="white" port="ativo_e"><font color="#555555">smallint NN</font></td></tr></table>>];
  produto [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="5"><tr><td colspan="3" bgcolor="#1F4E79"><font color="white"><b>produto</b></font></td></tr><tr><td align="left" bgcolor="#FFF2CC" port="id_produto_w">PK</td><td align="left" bgcolor="#FFF2CC"><b>id_produto</b></td><td align="left" bgcolor="#FFF2CC" port="id_produto_e"><font color="#555555">serial</font></td></tr><tr><td align="left" bgcolor="white" port="nome_w"></td><td align="left" bgcolor="white">nome</td><td align="left" bgcolor="white" port="nome_e"><font color="#555555">varchar(100) NN,U*</font></td></tr><tr><td align="left" bgcolor="white" port="marca_w"></td><td align="left" bgcolor="white">marca</td><td align="left" bgcolor="white" port="marca_e"><font color="#555555">varchar(60) NN,U*</font></td></tr><tr><td align="left" bgcolor="white" port="categoria_w"></td><td align="left" bgcolor="white">categoria</td><td align="left" bgcolor="white" port="categoria_e"><font color="#555555">varchar(30) NN</font></td></tr><tr><td align="left" bgcolor="white" port="preco_venda_w"></td><td align="left" bgcolor="white">preco_venda</td><td align="left" bgcolor="white" port="preco_venda_e"><font color="#555555">numeric(10,2) NN</font></td></tr><tr><td align="left" bgcolor="white" port="qtd_estoque_w"></td><td align="left" bgcolor="white">qtd_estoque</td><td align="left" bgcolor="white" port="qtd_estoque_e"><font color="#555555">integer NN</font></td></tr><tr><td align="left" bgcolor="white" port="estoque_minimo_w"></td><td align="left" bgcolor="white">estoque_minimo</td><td align="left" bgcolor="white" port="estoque_minimo_e"><font color="#555555">integer NN</font></td></tr><tr><td align="left" bgcolor="white" port="codigo_barras_w"></td><td align="left" bgcolor="white">codigo_barras</td><td align="left" bgcolor="white" port="codigo_barras_e"><font color="#555555">char(13) U</font></td></tr><tr><td align="left" bgcolor="white" port="ativo_w"></td><td align="left" bgcolor="white">ativo</td><td align="left" bgcolor="white" port="ativo_e"><font color="#555555">boolean NN</font></td></tr></table>>];
  agendamento [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="5"><tr><td colspan="3" bgcolor="#2E75B6"><font color="white"><b>agendamento</b></font></td></tr><tr><td align="left" bgcolor="#FFF2CC" port="id_agendamento_w">PK</td><td align="left" bgcolor="#FFF2CC"><b>id_agendamento</b></td><td align="left" bgcolor="#FFF2CC" port="id_agendamento_e"><font color="#555555">serial</font></td></tr><tr><td align="left" bgcolor="#E2EFDA" port="id_cliente_w">FK</td><td align="left" bgcolor="#E2EFDA">id_cliente</td><td align="left" bgcolor="#E2EFDA" port="id_cliente_e"><font color="#555555">integer NN</font></td></tr><tr><td align="left" bgcolor="#E2EFDA" port="id_profissional_w">FK</td><td align="left" bgcolor="#E2EFDA">id_profissional</td><td align="left" bgcolor="#E2EFDA" port="id_profissional_e"><font color="#555555">integer NN</font></td></tr><tr><td align="left" bgcolor="#E2EFDA" port="id_servico_w">FK</td><td align="left" bgcolor="#E2EFDA">id_servico</td><td align="left" bgcolor="#E2EFDA" port="id_servico_e"><font color="#555555">integer NN</font></td></tr><tr><td align="left" bgcolor="white" port="data_agendamento_w"></td><td align="left" bgcolor="white">data_agendamento</td><td align="left" bgcolor="white" port="data_agendamento_e"><font color="#555555">date NN</font></td></tr><tr><td align="left" bgcolor="white" port="hora_w"></td><td align="left" bgcolor="white">hora</td><td align="left" bgcolor="white" port="hora_e"><font color="#555555">text</font></td></tr><tr><td align="left" bgcolor="white" port="valor_w"></td><td align="left" bgcolor="white">valor</td><td align="left" bgcolor="white" port="valor_e"><font color="#555555">numeric(10,2)</font></td></tr><tr><td align="left" bgcolor="white" port="status_w"></td><td align="left" bgcolor="white">status</td><td align="left" bgcolor="white" port="status_e"><font color="#555555">text NN</font></td></tr></table>>];
  pagamento [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="5"><tr><td colspan="3" bgcolor="#2E75B6"><font color="white"><b>pagamento</b></font></td></tr><tr><td align="left" bgcolor="#FFF2CC" port="id_pagamento_w">PK</td><td align="left" bgcolor="#FFF2CC"><b>id_pagamento</b></td><td align="left" bgcolor="#FFF2CC" port="id_pagamento_e"><font color="#555555">serial</font></td></tr><tr><td align="left" bgcolor="#E2EFDA" port="id_agendamento_w">FK</td><td align="left" bgcolor="#E2EFDA">id_agendamento</td><td align="left" bgcolor="#E2EFDA" port="id_agendamento_e"><font color="#555555">integer NN,U</font></td></tr><tr><td align="left" bgcolor="white" port="forma_pagamento_w"></td><td align="left" bgcolor="white">forma_pagamento</td><td align="left" bgcolor="white" port="forma_pagamento_e"><font color="#555555">varchar(20) NN</font></td></tr><tr><td align="left" bgcolor="white" port="valor_pago_w"></td><td align="left" bgcolor="white">valor_pago</td><td align="left" bgcolor="white" port="valor_pago_e"><font color="#555555">numeric(10,2) NN</font></td></tr><tr><td align="left" bgcolor="white" port="desconto_w"></td><td align="left" bgcolor="white">desconto</td><td align="left" bgcolor="white" port="desconto_e"><font color="#555555">numeric(10,2) NN</font></td></tr><tr><td align="left" bgcolor="white" port="parcelas_w"></td><td align="left" bgcolor="white">parcelas</td><td align="left" bgcolor="white" port="parcelas_e"><font color="#555555">smallint NN</font></td></tr><tr><td align="left" bgcolor="white" port="data_hora_pagamento_w"></td><td align="left" bgcolor="white">data_hora_pagamento</td><td align="left" bgcolor="white" port="data_hora_pagamento_e"><font color="#555555">timestamp NN</font></td></tr></table>>];
  venda_produto [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="5"><tr><td colspan="3" bgcolor="#2E75B6"><font color="white"><b>venda_produto</b></font></td></tr><tr><td align="left" bgcolor="#FFF2CC" port="id_venda_w">PK</td><td align="left" bgcolor="#FFF2CC"><b>id_venda</b></td><td align="left" bgcolor="#FFF2CC" port="id_venda_e"><font color="#555555">serial</font></td></tr><tr><td align="left" bgcolor="#E2EFDA" port="id_cliente_w">FK</td><td align="left" bgcolor="#E2EFDA">id_cliente</td><td align="left" bgcolor="#E2EFDA" port="id_cliente_e"><font color="#555555">integer NN</font></td></tr><tr><td align="left" bgcolor="#E2EFDA" port="id_produto_w">FK</td><td align="left" bgcolor="#E2EFDA">id_produto</td><td align="left" bgcolor="#E2EFDA" port="id_produto_e"><font color="#555555">integer NN</font></td></tr><tr><td align="left" bgcolor="#E2EFDA" port="id_profissional_w">FK</td><td align="left" bgcolor="#E2EFDA">id_profissional</td><td align="left" bgcolor="#E2EFDA" port="id_profissional_e"><font color="#555555">integer</font></td></tr><tr><td align="left" bgcolor="white" port="quantidade_w"></td><td align="left" bgcolor="white">quantidade</td><td align="left" bgcolor="white" port="quantidade_e"><font color="#555555">smallint NN</font></td></tr><tr><td align="left" bgcolor="white" port="valor_unitario_w"></td><td align="left" bgcolor="white">valor_unitario</td><td align="left" bgcolor="white" port="valor_unitario_e"><font color="#555555">numeric(10,2) NN</font></td></tr><tr><td align="left" bgcolor="white" port="forma_pagamento_w"></td><td align="left" bgcolor="white">forma_pagamento</td><td align="left" bgcolor="white" port="forma_pagamento_e"><font color="#555555">varchar(20) NN</font></td></tr><tr><td align="left" bgcolor="white" port="data_venda_w"></td><td align="left" bgcolor="white">data_venda</td><td align="left" bgcolor="white" port="data_venda_e"><font color="#555555">timestamp NN</font></td></tr></table>>];
  agendamento:id_agendamento_e:e -> pagamento:id_agendamento_w:w [arrowtail=teetee, arrowhead=teeodot, label="on delete restrict\non update cascade"];
  cliente:id_cliente_e:e -> agendamento:id_cliente_w:w [arrowtail=teetee, arrowhead=crowodot, label="on delete restrict\non update cascade"];
  profissional:id_profissional_e:e -> agendamento:id_profissional_w:w [arrowtail=teetee, arrowhead=crowodot, label="on delete restrict\non update cascade"];
  servico:id_servico_e:e -> agendamento:id_servico_w:w [arrowtail=teetee, arrowhead=crowodot, label="on delete restrict\non update cascade"];
  cliente:id_cliente_e:e -> venda_produto:id_cliente_w:w [arrowtail=teetee, arrowhead=crowodot, label="on delete restrict\non update cascade"];
  produto:id_produto_e:e -> venda_produto:id_produto_w:w [arrowtail=teetee, arrowhead=crowodot, label="on delete restrict\non update cascade"];
  profissional:id_profissional_e:e -> venda_produto:id_profissional_w:w [arrowtail=teeodot, arrowhead=crowodot, label="on delete set null\non update cascade"];
  { rank=same; cliente; profissional; servico; produto; }
  { rank=same; agendamento; venda_produto; }
  legenda [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4">
<tr><td colspan="2" bgcolor="#EEEEEE"><b>Legenda</b></td></tr>
<tr><td bgcolor="#FFF2CC">PK</td><td align="left">chave primária</td></tr>
<tr><td bgcolor="#E2EFDA">FK</td><td align="left">chave estrangeira</td></tr>
<tr><td>NN</td><td align="left">NOT NULL</td></tr>
<tr><td>U</td><td align="left">UNIQUE</td></tr>
<tr><td>U*</td><td align="left">UNIQUE composto (nome, marca)</td></tr>
<tr><td>||  /  |o</td><td align="left">exatamente um / zero ou um</td></tr>
<tr><td>&gt;o</td><td align="left">zero ou muitos</td></tr>
</table>>];
  { rank=same; pagamento; legenda; }
}
